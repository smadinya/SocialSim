# Track C runs fully with the server off, so no keys are required to render.
# MOCK_LLM=1 forces the bucketed fallback lines in ai/fallbacks.ts and makes
# zero API calls. Remove it (or set anything else) and real dialogue is used
# IF a key is present — no key means mock mode regardless, so the game is
# always playable with the network unplugged.
MOCK_LLM=1

# Track B owns these. Never prefix a key with NEXT_PUBLIC_.
# GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite — fast, cheap, and the free tier
# allows enough requests per day to actually play. gemini-3.6-flash is the
# bigger model but is capped at 20 requests/day on the free tier, which is
# roughly seven turns. Model names churn; check AI Studio if calls start 404ing.
# GEMINI_MODEL=
