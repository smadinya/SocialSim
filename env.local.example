# Track C runs fully with the server off, so no keys are required to render.
# When Track B's Gemini client lands, set MOCK_LLM=0 to use real dialogue.
# Until then, leave this at 1 and the app uses instant stub text.
MOCK_LLM=1

# Track B owns this. Never prefix it with NEXT_PUBLIC_.
# GEMINI_API_KEY=
